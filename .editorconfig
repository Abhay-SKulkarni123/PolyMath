# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

# Top-level EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# TOML files
[*.toml]
indent_size = 2

# Python files
[*.py]
indent_size = 4
max_line_length = 127

# Python test files
[**/tests.py]
indent_size = 4
max_line_length = 127

# TypeScript/JavaScript files
[*.{ts,tsx}]
indent_size = 2
max_line_length = 120

# JavaScript files
[*.{js,jsx}]
indent_size = 2
max_line_length = 120

# CSS/SCSS files
[*.{css,scss}]
indent_size = 2

# HTML files
[*.html]
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# .env files - don't trim trailing whitespace (might be important)
[*.env*]
trim_trailing_whitespace = false

# Lock files - keep as-is
[package-lock.json]
indent_size = 2
trim_trailing_whitespace = false

# Git files
[.gitattributes]
indent_size = 4

[.gitignore]
indent_size = 4